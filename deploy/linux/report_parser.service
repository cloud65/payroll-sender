[Unit]
Description=FastAPI app (report-parser)
After=network.target

[Service]
User=report_parser
WorkingDirectory=/opt/report_parser
EnvironmentFile=/opt/report_parser/.env
ExecStart=/opt/report_parser/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --log-level warning

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target